    CabOrders   [][]bool
    HallOrders  [][]bool
  }

 func isValid(s ElevatorState) bool {

    if s.Motor != Stopped && s.DoorOpen {
        return false
    }

    if s.Floor < 0 || s.Floor >= NumFloors {
        return false
    }

    return true
}
